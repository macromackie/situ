{
  "name": "situ",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "test:live": "tsx tests/live.ts",
    "situ": "tsx src/cli/main.ts",
    "start": "tsx src/cli/main.ts serve",
    "install:cli": "tsx scripts/install.ts",
    "format": "prettier --write src scripts tests docs .context .contracts README.md AGENTS.md",
    "storybook": "storybook dev -p 6143 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@visx/scale": "4.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}

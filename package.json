{
  "name": "situ",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "vite build --config workspaces/web/vite.config.ts && tsx scripts/build.ts",
    "start": "tsx workspaces/cli/src/start.ts",
    "situ": "tsx workspaces/cli/src/main.ts",
    "check": "tsc --noEmit && prettier --check . && tsx --test workspaces/server/tests/*.test.ts && pnpm build",
    "format": "prettier --write .",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.40",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
